# The host service (docs/adr/0030): it starts the machine at boot, restarts it when it exits, and
# applies the release the product asks for in ~/acornfall/state/host/want.json.
#
# This file is not installed by anything. Copy it where your init reads units, point ExecStart at
# your own binary, and enable it:
#
#   cp acornfall-machine.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now acornfall-machine.service
#
# The appliance is a microVM and needs /dev/kvm, so the user that runs this must be in the kvm
# group. The machine's disk, its artifact and the engine live under ~/.acornfall; the mount is
# ~/acornfall. A different --home or --root needs a different ExecStart.

[Unit]
Description=acornfall: the machine, and the release it runs
Documentation=https://github.com/marcelowa/acornfall/blob/main/docs/adr/0030-the-host-supervises-the-machine.md
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/acornfall machine serve
# A service that exits is a machine with nobody watching it, so it comes back. The machine itself is
# supervised inside, with a cap; this is the process, and a crash there is a crash to restart.
Restart=always
RestartSec=2
# The machine is a VM that this service starts and then leaves running. Stopping the service is not
# taking the machine down: it handles SIGTERM and exits without touching it.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
