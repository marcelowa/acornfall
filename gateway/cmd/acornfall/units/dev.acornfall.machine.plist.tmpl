<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The acornfall host service. Generated by `acornfall machine install`, from the declaration in
  {{SHARE}}/state/machine.json — do not edit it by hand: the next install writes it again (ADR 0030).

  It runs the install's own symlink through sh, because launchd does not expand "~" and the symlink is
  what lets the service replace itself (ADR 0031).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.acornfall.machine</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec "{{BINARY}}" machine serve --share {{SHARE}} --machinery {{MACHINERY}} --host {{HOST}} --port {{PORT}}</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- launchd has no StartLimitBurst: this only slows a restart loop down. -->
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>{{MACHINERY}}/machine.log</string>
	<key>StandardErrorPath</key>
	<string>{{MACHINERY}}/machine.log</string>
</dict>
</plist>
