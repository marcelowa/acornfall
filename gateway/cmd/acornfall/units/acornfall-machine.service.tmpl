# The acornfall host service. Generated by `acornfall machine install`, from the declaration in
# {{SHARE}}/state/machine.json — do not edit it by hand: the next install writes it again, and an
# edit that survives a while is an address the machine and the file disagree about (ADR 0030).
[Unit]
Description=acornfall: the machine, and the release it runs
Documentation=https://github.com/marcelowa/acornfall/blob/main/docs/adr/0030-the-host-supervises-the-machine.md
After=default.target
# Both keys belong to [Unit]: systemd reads them there and nowhere else, so in [Service] a binary that
# cannot run would restart every RestartSec for ever instead of going to failed.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# The install's own symlink, which is what lets the service replace itself (ADR 0031). The flags are the
# resolved install: the same address the declaration holds.
ExecStart={{BINARY}} machine serve --share {{SHARE}} --machinery {{MACHINERY}} --host {{HOST}} --port {{PORT}}
# A service that exits comes back; the machine inside is supervised, with a cap.
Restart=always
RestartSec=2
# The machine is a VM this process starts and then leaves running: stopping the service is not taking the
# machine down, and it handles SIGTERM by exiting without touching it.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
